# Bullseye Backend Server Configuration

# Server Port (default: 4000)
PORT=4000

# Node Environment: development | production | test
NODE_ENV=development

# Allowed CORS Origin for Frontend Client (e.g., http://localhost:5173 or * in development)
CORS_ORIGIN=http://localhost:5173

# Canvas LMS Integration (Optional)
# Base URL for Canvas LMS instance (e.g., https://canvas.eee.uci.edu)
CANVAS_BASE_URL=https://canvas.eee.uci.edu
# Canvas API Developer Access Token
CANVAS_API_TOKEN=your_canvas_api_token_here

# EdStem Classroom Q&A Integration (Optional)
# EdStem Course ID or API endpoint
EDSTEM_COURSE_ID=your_edstem_course_id_here
# EdStem API Access Token
EDSTEM_API_TOKEN=your_edstem_api_token_here
