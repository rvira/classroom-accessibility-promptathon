# Bullseye Fullstack Environment Configuration

# ------------------------------------------------------------------------------
# Frontend Client Configuration (Vite)
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:4000
VITE_APP_TITLE="Bullseye · Classroom Accessibility Layer"
VITE_ENABLE_SENSORY_CALM_DEFAULT=false

# ------------------------------------------------------------------------------
# Backend API Configuration
# ------------------------------------------------------------------------------
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Canvas LMS Integration (Optional)
CANVAS_BASE_URL=https://canvas.eee.uci.edu
CANVAS_API_TOKEN=your_canvas_api_token_here

# EdStem Classroom Q&A Integration (Optional)
EDSTEM_COURSE_ID=your_edstem_course_id_here
EDSTEM_API_TOKEN=your_edstem_api_token_here
